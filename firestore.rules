rules_version = '2';

// Firestore Security Rules — Limbo
//
// Головне правило: кожен пише лише у власний документ users/{uid}.
// Цього достатньо, щоб ніхто не зіпсував чужий прогрес.
//
// Читання відкрите всім автентифікованим, бо лідерборд (loadTopPlayers)
// робить запит по всій колекції users. Побічний ефект — залогінений
// користувач бачить чужі settings і progress. Виправлення описане
// в BACKLOG.md (окрема колекція /leaderboard).
//
// Свідомо НЕ перевіряємо тут кількість зірок, монотонність прогресу
// й накрутку часу. Такі правила виходять громіздкими, а Firestore має
// ліміт у 1000 виразів на перевірку — попередня, докладніша редакція
// його вичерпала й почала відхиляти УСІ записи. Гравець, який полізе
// в консоль накручувати собі зірки, обманює лише себе.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Усе інше закрито.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
