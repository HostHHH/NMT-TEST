rules_version = '2';

// Firestore Security Rules — iSторія
//
// 1. Користувачі: читання й запис ТІЛЬКИ власнику (isOwner).
//    Ніхто сторонній не може прочитати чужі settings, progress чи приватні дані.
// 2. Лідерборд: відкритий на читання всім автентифікованим,
//    але запис лише власнику документа (request.auth.uid == uid).
// 3. Сертифікати: публічне читання для перевірки журі (allow read: if true),
//    запис лише автентифікованим користувачам.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Приватні профілі користувачів (прогрес, налаштування теми, баланс)
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Публічна таблиця лідерів (лише displayName, highScore, updatedAt)
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid);
    }

    // Реєстр підтверджених сертифікатів (публічна перевірка для журі та вчителів)
    match /certificates/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Усе інше закрито
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
